##############################################################################

# Make the boot and app
mkdir -p /boot
mkdir -p /app

# Standard SD-memory[0] card interface
if [ -e /dev/mmcblk0 ]
then
   mount /dev/mmcblk0p1 /boot > /dev/null 2>&1
   mount /dev/mmcblk0p2 /app
fi

##############################################################################

# Standard SD-memory[1] card interface
if [ -e /dev/mmcblk1 ]
then
   mount /dev/mmcblk1p1 /boot > /dev/null 2>&1
   mount /dev/mmcblk1p2 /app
fi

##############################################################################

# KR260 using USB mounted SD-memory card
if [ -e /dev/sda ]
then
   mount /dev/sda1 /boot > /dev/null 2>&1
   mount /dev/sda2 /app
fi

##############################################################################

# Ensure persistent SSH keys are used
mkdir -p /boot/ssh
if [ ! -f /boot/ssh/ssh_host_ed25519_key ]; then
   # echo "Generating new SSH host keys..."
   ssh-keygen -A
   mv /etc/ssh/ssh_host_* /boot/ssh/
fi

# Copy all SSH host keys from persistent storage to rootfs
for keyfile in /boot/ssh/ssh_host_*; do
   link_path="/etc/ssh/$(basename "$keyfile")"
   if [ ! -L "$link_path" ] || [ "$(readlink "$link_path")" != "$keyfile" ]; then
      cp -f "$keyfile" "$link_path"
      # echo "Copied $keyfile to $link_path"
      chmod 600 /etc/ssh/ssh_host_*
      chown root:root /etc/ssh/ssh_host_*
   fi
done

# Restarting SSH service
/usr/sbin/sshd

##############################################################################

# Check if mac file exists in SD boot partition
if [ -f "/boot/mac" ]
then
   # Set the MAC address with file
   ip link set dev eth0 down
   ip link set dev eth0 address $(cat /boot/mac)
   ip link set dev eth0 up
   /etc/init.d/networking restart
fi

# Check if ip file exists in SD boot partition
if [ -f "/boot/ip" ]
then
   # Set the IP address with file
   ip addr add $(cat /boot/ip)/24 dev eth0
fi

##############################################################################

# Check if drivers already load before loading 2nd stage boot
if [ -f "/proc/axi_stream_dma_0" ]
then
   # Kill any stale runtime applications
   killall jupyter > /dev/null 2>&1
   killall python3 > /dev/null 2>&1
   sleep 5
   # Remove kernel drivers in-case they are already loaded
   rmmod -s axi_memory_map
   rmmod -s axi_stream_dma
fi

##############################################################################

# Load the user's firmware (PL) .pdi file (A.K.A. "2nd stage boot")
# Versal Segmented Configuration: pl.pdi is the runtime/dynamic PDI.
# The base PDI lives in BOOT.BIN. See axi-soc-versal-core README
# section "Why Versal differs from ZynqMP for runtime PL loading".
if [ -f "/boot/pl.pdi" ] && [ -f "/boot/pl.dtbo" ]
then
   echo "2nd-stage PL load: /boot/pl.pdi + /boot/pl.dtbo present"

   # Remove Full Overlay (fpgautil is "flaky" - retry with 30-iteration cap)
   retry=0
   while [ ! -z "$(fpgautil -R -n full 2>&1 | grep -i failed)" ]
   do
      retry=$((retry + 1))
      if [ "$retry" -ge 30 ]
      then
         echo "ERROR: fpgautil remove overlay failed after $retry retries"
         break
      fi
      sleep 1
   done

   # Program the PL overlay (fpgautil is "flaky" - retry with 30-iteration cap)
   retry=0
   while [ ! -z "$(fpgautil -o /boot/pl.dtbo -b /boot/pl.pdi 2>&1 | grep -i failed)" ]
   do
      retry=$((retry + 1))
      if [ "$retry" -ge 30 ]
      then
         echo "ERROR: fpgautil program PDI failed after $retry retries"
         break
      fi
      sleep 1
   done

   # Get the status
   echo "/sys/class/fpga_manager/fpga0/state: $(cat /sys/class/fpga_manager/fpga0/state)"
elif [ -f "/boot/pl.pdi" ] || [ -f "/boot/pl.dtbo" ]
then
   echo "WARNING: 2nd-stage PL load skipped - need BOTH /boot/pl.pdi and /boot/pl.dtbo"
   ls -la /boot/pl.pdi /boot/pl.dtbo 2>&1
fi

# Load custom kernel driver
insmod /lib/modules/$(uname -r)/updates/axi_memory_map.ko
insmod /lib/modules/$(uname -r)/updates/axi_stream_dma.ko cfgTxCount0=@DMA_TX_BUFF_COUNT@ cfgRxCount0=@DMA_RX_BUFF_COUNT@ cfgSize0=@DMA_BUFF_SIZE@

##############################################################################

# Load AIE PDI overlay(s) from /boot/aie/, then start a per-image
# aie-partition-init@<name>.service instance for each one.
# Each AIE PDI is a CDO-only segmented overlay that stacks on the PL
# programmed above; do NOT issue `fpgautil -R -n full` here — that would tear
# down the PL fabric. The single -R -n full executed before the pl.pdi load
# already cleared any prior overlays, so re-entry is safe.
# Multiple images are loaded in lexicographic order; user controls order via
# filename prefix (e.g. 00_loopback.pdi, 10_extra.pdi).
if [ ! -d /sys/class/aie ]
then
   echo "AIE not present (no /sys/class/aie) - skipping AIE PDI load"
elif [ ! -d /boot/aie ]
then
   echo "No /boot/aie directory - no AIE images to load"
else
   for pdi in /boot/aie/*.pdi
   do
      [ -f "$pdi" ] || continue   # empty glob guard
      base="${pdi%.pdi}"
      name="$(basename "$base")"
      dtbo="${base}.dtbo"
      conf="${base}.partition.conf"
      if [ ! -f "$dtbo" ]
      then
         echo "WARNING: skipping $pdi - no matching $dtbo"
         continue
      fi
      echo "AIE load: $pdi + $dtbo"

      # Program the AIE overlay (fpgautil is "flaky" - retry with 30-iteration cap)
      ok=0
      retry=0
      while [ ! -z "$(fpgautil -o $dtbo -b $pdi 2>&1 | grep -i failed)" ]
      do
         retry=$((retry + 1))
         if [ "$retry" -ge 30 ]
         then
            echo "ERROR: fpgautil program AIE PDI $pdi failed after $retry retries"
            break
         fi
         sleep 1
      done
      if [ "$retry" -lt 30 ]
      then
         ok=1
      fi
      echo "/sys/class/fpga_manager/fpga0/state: $(cat /sys/class/fpga_manager/fpga0/state)"

      if [ "$ok" -eq 1 ]
      then
         if [ -f "$conf" ]
         then
            echo "AIE partition-init: starting aie-partition-init@${name}.service"
            systemctl start "aie-partition-init@${name}.service" || \
               echo "WARNING: aie-partition-init@${name}.service failed to start"
         else
            echo "WARNING: $conf missing - skipping aie-partition-init for $name"
         fi
      fi
   done
fi

##############################################################################

# Dump AxiVersion Status
/usr/bin/axiversiondump

# Check if user's runtime application exists
if [ -f "/app/runtimeApp" ]
then
   echo "Starting the user's custom runtime Application (/app/runtimeApp)"
   /app/runtimeApp
else
   echo "Starting the generic rogue TCP bridge Application"
   /usr/bin/roguetcpbridge --lane @DMA_NUM_LANES@ --tdest @DMA_NUM_DEST@
fi

##############################################################################
